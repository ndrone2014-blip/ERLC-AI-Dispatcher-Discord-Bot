# ===================================================================
#  Pulse Dispatch | ERLC — configuration
#  Copy this file to ".env" and fill in the values. NEVER share .env.
# ===================================================================

# --- Discord (required) ---------------------------------------------
# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=
# Optional: your server's ID. Slash commands appear instantly there (global sync can take ~1 hour).
DEV_GUILD_ID=

# --- Google Gemini (primary AI, free tier) ---------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Local safety limit for requests per day (keep at/below your real free-tier quota)
GEMINI_DAILY_REQUEST_LIMIT=200

# --- More AI providers (all optional) -----------------------------------
# Server administrators can ALSO add their own keys from Discord with /ai-provider key
# (stored encrypted, per server). Keys here are the bot owner's defaults for every server.
# Free tiers (no card needed):
OPENROUTER_API_KEY=          # https://openrouter.ai/settings/keys   (use models ending in :free)
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=                # https://console.groq.com/keys
CEREBRAS_API_KEY=            # https://cloud.cerebras.ai/
MISTRAL_API_KEY=             # https://console.mistral.ai/api-keys    (free Experiment plan)
SAMBANOVA_API_KEY=           # https://cloud.sambanova.ai/apis
NVIDIA_API_KEY=              # https://build.nvidia.com/             (free Developer Program)
GITHUB_MODELS_TOKEN=         # https://github.com/settings/personal-access-tokens/new  (Models: read)
CLOUDFLARE_API_TOKEN=        # https://dash.cloudflare.com/profile/api-tokens  (Workers AI template)
CLOUDFLARE_ACCOUNT_ID=
# Trial / small credits only:
COHERE_API_KEY=              # https://dashboard.cohere.com/api-keys  (trial key, non-commercial)
HUGGINGFACE_API_KEY=         # https://huggingface.co/settings/tokens (tiny monthly credit)
# Paid (billing required):
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
# Optional per-provider model override: <PROVIDER>_MODEL, e.g. GROQ_MODEL=llama-3.1-8b-instant

# Ollama (free, runs on your PC): https://ollama.com  e.g. http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
# Any other OpenAI-compatible endpoint (LM Studio, vLLM, a proxy...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- ER:LC -----------------------------------------------------------
# Recommended: set the server key from Discord (/settings erlc-key or the ER:LC panel);
# it is then stored encrypted. A key here is only used if none is stored.
ERLC_SERVER_KEY=
# Only needed for public apps used by many servers
ERLC_GLOBAL_KEY=
ERLC_POLL_SECONDS=5

# Optional event webhook receiver (needs a public HTTPS URL, e.g. Cloudflare Tunnel)
ERLC_WEBHOOK_ENABLED=false
ERLC_WEBHOOK_HOST=0.0.0.0
ERLC_WEBHOOK_PORT=8085

# --- Security ----------------------------------------------------------
# Encryption key for stored credentials. Leave empty to auto-generate data/secret.key (back it up!).
SECRET_KEY=

# --- Web dashboard (v4.0) ------------------------------------------------
# The dashboard runs inside the bot. Full guide: docs/DASHBOARD.md
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# The address people open in their browser (no trailing slash). Empty = http://localhost:8080 (this PC only).
# Example with a tunnel: https://pulse.yourname.com   (then also set DASHBOARD_TRUST_PROXY=true)
DASHBOARD_PUBLIC_URL=
DASHBOARD_TRUST_PROXY=false
# Developer Portal -> your application -> OAuth2 -> Client Secret (Reset Secret). Needed to sign in.
# Also add this Redirect there: <DASHBOARD_PUBLIC_URL or http://localhost:8080>/auth/callback
DISCORD_CLIENT_SECRET=
# Optional: only if your OAuth app is different from the bot's application
DISCORD_CLIENT_ID=

# --- Roblox verification (v4.0) -----------------------------------------
# Profile-code verification needs NOTHING here. These are only for the optional "Sign in with Roblox"
# button (create.roblox.com -> OAuth 2.0 Apps). Guide: docs/ROBLOX_VERIFICATION.md
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# --- Voice -------------------------------------------------------------
# Full path to ffmpeg.exe if "ffmpeg" on PATH is old or missing
FFMPEG_PATH=ffmpeg
PIPER_VOICE_DIR=data/voices
PIPER_DEFAULT_VOICE=en_US-ryan-medium
# Whisper speech-to-text: tiny.en (fastest) / base.en (default) / small.en (most accurate, slower)
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Misc ----------------------------------------------------------------
LOG_LEVEL=INFO
TEST_MODE=false
