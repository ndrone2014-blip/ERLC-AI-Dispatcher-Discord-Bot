# ===================================================================
#  ER:LC AI Dispatch — configuration
#  Copy this file to ".env" and fill in the values. NEVER share .env.
# ===================================================================

# --- Discord (required) ---------------------------------------------
# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=
# Optional: your server's ID. Slash commands appear instantly there (global sync can take ~1 hour).
DEV_GUILD_ID=

# --- Google Gemini (primary AI, free tier) ---------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Local safety limit for requests per day (keep at/below your real free-tier quota)
GEMINI_DAILY_REQUEST_LIMIT=200

# --- Optional fallback AI providers -----------------------------------
# Ollama (free, runs on your PC): https://ollama.com  e.g. http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
# Any OpenAI-compatible endpoint (Groq, OpenRouter, LM Studio...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- ER:LC -----------------------------------------------------------
# Recommended: set the server key from Discord (ER:LC Integration panel -> Set API Key);
# it is then stored encrypted. A key here is only used if none is stored.
ERLC_SERVER_KEY=
# Only needed for public apps used by many servers
ERLC_GLOBAL_KEY=
ERLC_POLL_SECONDS=5

# Optional event webhook receiver (needs a public HTTPS URL, e.g. Cloudflare Tunnel)
ERLC_WEBHOOK_ENABLED=false
ERLC_WEBHOOK_HOST=0.0.0.0
ERLC_WEBHOOK_PORT=8085

# --- Security ----------------------------------------------------------
# Encryption key for stored credentials. Leave empty to auto-generate data/secret.key (back it up!).
SECRET_KEY=

# --- Voice -------------------------------------------------------------
# Full path to ffmpeg.exe if "ffmpeg" on PATH is old or missing
FFMPEG_PATH=ffmpeg
PIPER_VOICE_DIR=data/voices
PIPER_DEFAULT_VOICE=en_US-ryan-medium
# Whisper speech-to-text: tiny.en (fastest) / base.en (default) / small.en (most accurate, slower)
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Misc ----------------------------------------------------------------
LOG_LEVEL=INFO
TEST_MODE=false
